diff --git a/Kits/FidelityFX/api/internal/ffx_internal_types.h b/Kits/FidelityFX/api/internal/ffx_internal_types.h
index 8543915..7925297 100644
--- a/Kits/FidelityFX/api/internal/ffx_internal_types.h
+++ b/Kits/FidelityFX/api/internal/ffx_internal_types.h
@@ -79,7 +79,16 @@
 #define FFX_API __declspec(dllexport)
 #endif // #if defined (FFX_GCC)
 
+// Linux port: every fixed-size name field inside the private effect contexts
+// is wchar_t[], and Linux wchar_t is 4 bytes rather than the 2 bytes upstream
+// budgeted for, which pushes FfxFsr3UpscalerContext_Private (819 KB) past the
+// 512 KB the upstream size reserves. Doubling the reservation keeps the
+// FFX_STATIC_ASSERT in fsr3upscalerCreate satisfied with room to spare.
+#if defined(__GNUC__) && !defined(_WIN32)
+#define FFX_SDK_DEFAULT_CONTEXT_SIZE (1024 * 256)
+#else
 #define FFX_SDK_DEFAULT_CONTEXT_SIZE (1024 * 128)
+#endif
 
 /// Maximum supported number of simultaneously bound SRVs.
 ///
