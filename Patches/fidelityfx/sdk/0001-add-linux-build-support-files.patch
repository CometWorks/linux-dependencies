@@ -0,0 +1,31 @@
+// This file is not part of the upstream FidelityFX SDK. It is added by the
+// Space Engineers 2 Linux dependency build (Patches/fidelityfx/).
+//
+// FfxWatermark draws AMD's debug watermark over the upscaled output. Its
+// implementation lives in AMD's closed "amdinternal" tree and has no public
+// source, so this build supplies a stub: the overlay is only ever constructed
+// when the MLSR-WATERMARK environment variable is set, and it renders nothing.
+
+#pragma once
+
+#include "../../../api/internal/ffx_interface.h"
+
+class FfxWatermark
+{
+public:
+    FfxWatermark(FfxInterface* backendInterface, FfxUInt32 effectContextId)
+        : m_backendInterface(backendInterface)
+        , m_effectContextId(effectContextId)
+    {
+    }
+
+    void Dispatch(FfxResourceInternal target, const char* message)
+    {
+        FFX_UNUSED(target);
+        FFX_UNUSED(message);
+    }
+
+private:
+    FfxInterface* m_backendInterface;
+    FfxUInt32     m_effectContextId;
+};
