diff --git a/include/native/windows/windows_base.h b/include/native/windows/windows_base.h
index 8650d2e..495ad63 100644
--- a/include/native/windows/windows_base.h
+++ b/include/native/windows/windows_base.h
@@ -27,7 +27,10 @@ typedef int32_t *LPLONG;
 
 typedef int32_t HRESULT;
 
-typedef wchar_t WCHAR;
+// Windows ABI: WCHAR is a 16-bit type. Managed interop layers (Vortice,
+// SharpDX) marshal WCHAR fields and strings with the Windows ABI, so the
+// native build must not substitute the 32-bit Linux wchar_t here.
+typedef uint16_t WCHAR;
 typedef WCHAR *NWPSTR, *LPWSTR, *PWSTR;
 typedef unsigned char UCHAR, *PUCHAR;
 
@@ -130,7 +133,7 @@ typedef UINT_PTR* PUINT_PTR;
 #endif /*STRICT*/
 
 typedef char* LPSTR;
-typedef const wchar_t* LPCWSTR;
+typedef const WCHAR* LPCWSTR;
 
 typedef struct LUID {
   DWORD LowPart;
diff --git a/src/d3d11/d3d11_fence.cpp b/src/d3d11/d3d11_fence.cpp
index 1ae07f7..7078f3e 100644
--- a/src/d3d11/d3d11_fence.cpp
+++ b/src/d3d11/d3d11_fence.cpp
@@ -80,10 +80,14 @@ namespace dxvk {
     WCHAR buffer[MAX_PATH];
     UNICODE_STRING name_str;
     if (lpName) {
-        DWORD session, len, name_len = wcslen(lpName);
+        // WCHAR is a 16-bit type on the native build, so the wchar_t-typed
+        // wcslen/swprintf cannot be used here; the prefix is formatted as
+        // UTF-8 and transcoded into the Windows-ABI buffer instead.
+        DWORD session, len, name_len = str::length(lpName);
 
         ProcessIdToSessionId(GetCurrentProcessId(), &session);
-        len = swprintf(buffer, ARRAYSIZE(buffer), L"\\Sessions\\%u\\BaseNamedObjects\\", session);
+        std::string prefix = str::format("\\Sessions\\", session, "\\BaseNamedObjects\\");
+        len = str::transcodeString(buffer, ARRAYSIZE(buffer), prefix.c_str(), prefix.size());
         memcpy(buffer + len, lpName, (name_len + 1) * sizeof(WCHAR));
         name_str.MaximumLength = name_str.Length = (len + name_len) * sizeof(WCHAR);
         name_str.MaximumLength += sizeof(WCHAR);
