diff --git a/src/wsi/sdl2/wsi_monitor_sdl2.cpp b/src/wsi/sdl2/wsi_monitor_sdl2.cpp
index d021346..8fbb696 100644
--- a/src/wsi/sdl2/wsi_monitor_sdl2.cpp
+++ b/src/wsi/sdl2/wsi_monitor_sdl2.cpp
@@ -37,13 +37,14 @@ namespace dxvk::wsi {
     if (!isDisplayValid(displayId))
       return false;
 
-    std::wstringstream nameStream;
-    nameStream << LR"(\\.\DISPLAY)" << (displayId + 1);
-
-    std::wstring name = nameStream.str();
+    // WCHAR is a 16-bit type on the native build, so the display name is
+    // assembled as UTF-8 and transcoded into the Windows-ABI buffer.
+    std::string name = str::format(R"(\\.\DISPLAY)", displayId + 1);
 
     std::memset(Name, 0, sizeof(Name));
-    name.copy(Name, name.length(), 0);
+    str::transcodeString(Name,
+      sizeof(Name) / sizeof(Name[0]) - 1,
+      name.c_str(), name.size());
 
     return true;
   }
