 namespace dxcutil {
 
+static std::vector<char> WindowsToUtf8(const char16_t *value, size_t length) {
+  std::vector<char> result;
+  result.reserve(length);
+  for (size_t i = 0; i < length; ++i) {
+    uint32_t codepoint = value[i];
+    if (codepoint >= 0xd800 && codepoint <= 0xdbff && i + 1 < length &&
+        value[i + 1] >= 0xdc00 && value[i + 1] <= 0xdfff)
+      codepoint =
+          0x10000 + ((codepoint - 0xd800) << 10) + (value[++i] - 0xdc00);
+
+    if (codepoint <= 0x7f)
+      result.push_back(static_cast<char>(codepoint));
+    else if (codepoint <= 0x7ff) {
+      result.push_back(static_cast<char>(0xc0 | (codepoint >> 6)));
+      result.push_back(static_cast<char>(0x80 | (codepoint & 0x3f)));
+    } else if (codepoint <= 0xffff) {
+      result.push_back(static_cast<char>(0xe0 | (codepoint >> 12)));
+      result.push_back(static_cast<char>(0x80 | ((codepoint >> 6) & 0x3f)));
+      result.push_back(static_cast<char>(0x80 | (codepoint & 0x3f)));
+    } else {
+      result.push_back(static_cast<char>(0xf0 | (codepoint >> 18)));
+      result.push_back(static_cast<char>(0x80 | ((codepoint >> 12) & 0x3f)));
+      result.push_back(static_cast<char>(0x80 | ((codepoint >> 6) & 0x3f)));
+      result.push_back(static_cast<char>(0x80 | (codepoint & 0x3f)));
+    }
+  }
+  return result;
+}
+
+std::wstring WindowsToNativeString(LPCWSTR value) {
+  const char16_t *input = reinterpret_cast<const char16_t *>(value);
+  std::wstring result;
+  if (!input)
+    return result;
+
+  while (*input) {
+    uint32_t codepoint = *input++;
+    if (codepoint >= 0xd800 && codepoint <= 0xdbff && *input >= 0xdc00 &&
+        *input <= 0xdfff)
+      codepoint =
+          0x10000 + ((codepoint - 0xd800) << 10) + (*input++ - 0xdc00);
+    result.push_back(static_cast<wchar_t>(codepoint));
+  }
+  return result;
+}
+
+HRESULT LoadWindowsInclude(IDxcIncludeHandler *handler, LPCWSTR filename,
+                           IDxcBlob **source) {
+  std::u16string windowsFilename;
+  for (; *filename; ++filename) {
+    uint32_t codepoint = static_cast<uint32_t>(*filename);
+    if (codepoint <= 0xffff)
+      windowsFilename.push_back(static_cast<char16_t>(codepoint));
+    else {
+      codepoint -= 0x10000;
+      windowsFilename.push_back(
+          static_cast<char16_t>(0xd800 + (codepoint >> 10)));
+      windowsFilename.push_back(
+          static_cast<char16_t>(0xdc00 + (codepoint & 0x3ff)));
+    }
+  }
+
+  HRESULT status = handler->LoadSource(
+      reinterpret_cast<LPCWSTR>(windowsFilename.c_str()), source);
+  if (FAILED(status) || !source || !*source)
+    return status;
+
+  CComPtr<IDxcBlob> windowsSource;
+  windowsSource.Attach(*source);
+  *source = nullptr;
+  size_t byteLength = windowsSource->GetBufferSize();
+  if (byteLength % sizeof(char16_t))
+    return E_FAIL;
+
+  std::vector<char> utf8 = WindowsToUtf8(
+      static_cast<const char16_t *>(windowsSource->GetBufferPointer()),
+      byteLength / sizeof(char16_t));
+  CComPtr<IDxcBlobEncoding> utf8Source;
+  IFR(hlsl::DxcCreateBlobWithEncodingOnHeapCopy(
+      utf8.data(), utf8.size(), DXC_CP_UTF8, &utf8Source));
+  return utf8Source.QueryInterface(source);
+}
